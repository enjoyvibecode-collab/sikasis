rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isSuperOwner() { 
      return isSignedIn() && request.auth.token.email == 'enjoyvibecode@gmail.com'; 
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function belongsToSchool(schoolId) { 
      return isSignedIn() && (isSuperOwner() || (currentUserExists() && currentUser().schoolId == schoolId)); 
    }

    function hasRole(schoolId, roles) {
      return isSignedIn() && (isSuperOwner() || (currentUserExists() && currentUser().schoolId == schoolId && (currentUser().role in roles)));
    }

    function isKepalaSekolah(schoolId) { return hasRole(schoolId, ['owner', 'kepala_sekolah']); }
    function isBendahara(schoolId) { return hasRole(schoolId, ['owner', 'bendahara']); }
    function isTU(schoolId) { return hasRole(schoolId, ['owner', 'tu']); }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['maintenanceMode', 'allowRegistrations']) && 
             data.keys().size() == 2 &&
             data.maintenanceMode is bool &&
             data.allowRegistrations is bool;
    }

    // --- Match Blocks ---

    match /system/config {
      allow read: if true;
      allow write: if isSuperOwner() && isValidSystemConfig(incoming());
    }

    // Audit Trail: Transactions are IMMUTABLE
    match /transactions/{txId} {
      allow get, list: if isSignedIn() && (isSuperOwner() || currentUser().schoolId == resource.data.schoolId);
      
      allow update, delete: if false;

      allow create: if isSignedIn() && (isSuperOwner() || (
                      incoming().schoolId == currentUser().schoolId && 
                      incoming().executorId == request.auth.uid &&
                      (incoming().timestamp == request.time || incoming().timestamp == null) &&
                      incoming().type in ['SETOR_TABUNGAN', 'TARIK_TABUNGAN', 'SETOR_KAS_KELAS', 'TARIK_KAS_KELAS', 'MODAL_TU_MASUK', 'MODAL_TU_KEMBALI', 'AUDIT_ADJUSTMENT_IN', 'AUDIT_ADJUSTMENT_OUT', 'INISIALISASI_TABUNGAN_SISWA', 'INISIALISASI_KAS_KELAS'] &&
                      incoming().amount >= 0));
    }

    match /schools/{schoolId} {
      allow get: if true; 
      allow list: if isSuperOwner();
      allow create: if isSignedIn();
      allow update: if isSuperOwner() || hasRole(schoolId, ['owner', 'kepala_sekolah', 'bendahara']);
    }

    match /announcements/{annId} {
      allow read: if true;
      allow create: if isSuperOwner() || isKepalaSekolah(incoming().schoolId);
      allow update, delete: if isSuperOwner() || isKepalaSekolah(existing().schoolId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || belongsToSchool(resource.data.schoolId) || isSuperOwner());
      allow list: if isSignedIn() && (
        isSuperOwner() || 
        (resource != null && belongsToSchool(resource.data.schoolId)) ||
        (resource.data.inviteEmail == request.auth.token.email)
      );
      allow create: if isSignedIn() && (request.auth.uid == userId || isKepalaSekolah(incoming().schoolId) || isSuperOwner()); 
      allow update: if isSuperOwner() || isKepalaSekolah(existing().schoolId) || (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'fullName']));
      allow delete: if isSuperOwner() || isKepalaSekolah(existing().schoolId);
    }

    match /classes/{classId} {
      allow read: if isSuperOwner() || belongsToSchool(resource.data.schoolId);
      allow create: if isSuperOwner() || isKepalaSekolah(incoming().schoolId) || isBendahara(incoming().schoolId);
      
      allow update: if isSuperOwner() || (belongsToSchool(existing().schoolId) && 
                      (isKepalaSekolah(existing().schoolId) || isBendahara(existing().schoolId) || isTU(existing().schoolId)));
      allow delete: if isSuperOwner() || isKepalaSekolah(existing().schoolId);
    }

    match /students/{studentId} {
      allow read: if isSuperOwner() || belongsToSchool(resource.data.schoolId) || true; // Keep true for lookup but prefer school check
      allow create: if isSuperOwner() || isKepalaSekolah(incoming().schoolId) || isTU(incoming().schoolId) || isBendahara(incoming().schoolId);
      
      allow update: if isSuperOwner() || (belongsToSchool(existing().schoolId) && 
                      (isKepalaSekolah(existing().schoolId) || isTU(existing().schoolId) || isBendahara(existing().schoolId)));
      allow delete: if isSuperOwner() || isKepalaSekolah(existing().schoolId);
    }

    match /tu_wallets/{walletId} {
      allow read: if belongsToSchool(resource.data.schoolId) || isSuperOwner();
      allow create, update: if belongsToSchool(incoming().schoolId) && 
                               (isKepalaSekolah(incoming().schoolId) || isBendahara(incoming().schoolId) || isTU(incoming().schoolId)) &&
                               getAfter(/databases/$(database)/documents/tu_wallets/$(walletId)).data.balance >= 0;
    }
  }
}
