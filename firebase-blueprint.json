{
  "entities": {
    "school": {
      "title": "School",
      "description": "Represents a school entity in the SaaS system.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerEmail": { "type": "string" },
        "centralBalance": { "type": "number", "description": "Cash held by school Bendahara" }
      },
      "required": ["name", "status"]
    },
    "user": {
      "title": "User",
      "description": "System users with specific roles.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "kepala_sekolah", "bendahara", "tu", "bendahara_kelas"] },
        "schoolId": { "type": "string" },
        "yearAssigned": { "type": "integer", "description": "7, 8, or 9 for TU" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["username", "role", "schoolId"]
    },
    "class": {
      "title": "Class",
      "description": "A specific class within a school.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "year": { "type": "integer", "description": "7, 8, or 9" },
        "name": { "type": "string" },
        "bendaharaKelasId": { "type": "string", "description": "User ID of the student representative" },
        "balanceCash": { "type": "number", "description": "Current class cash balance" }
      },
      "required": ["schoolId", "year", "name"]
    },
    "student": {
      "title": "Student",
      "description": "A student belonging to a class.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "nisn": { "type": "string" },
        "fullName": { "type": "string" },
        "balanceSavings": { "type": "number", "description": "Personal savings balance" }
      },
      "required": ["schoolId", "classId", "nisn", "fullName"]
    },
    "tu_wallet": {
      "title": "TU Wallet",
      "description": "Physical cash held by a specific TU staff member.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "tuId": { "type": "string" },
        "year": { "type": "integer" },
        "balance": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "tuId", "balance"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Audit-locked immutable ledger entry.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "studentId": { "type": "string", "description": "Optional: for savings" },
        "classId": { "type": "string", "description": "Optional: for class cash" },
        "tuId": { "type": "string", "description": "The TU staff involved" },
        "type": { "type": "string", "enum": ["TABUNGAN_SETOR", "TABUNGAN_TARIK", "KAS_KELAS_SETOR", "KAS_KELAS_TARIK", "MODAL_TU_MASUK", "MODAL_TU_KEMBALI"] },
        "amount": { "type": "number" },
        "executorId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "reversalOf": { "type": "string", "description": "If this is a correction of a previous TX" }
      },
      "required": ["schoolId", "type", "amount", "executorId", "timestamp"]
    },
    "system_config": {
      "title": "System Config",
      "description": "Global settings for the platform.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "allowRegistrations": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/schools/{schoolId}": { "schema": "school", "description": "School profile and central treasury" },
    "/users/{userId}": { "schema": "user", "description": "System users and permission assignments" },
    "/classes/{classId}": { "schema": "class", "description": "Class balance tracking" },
    "/students/{studentId}": { "schema": "student", "description": "Student identity and savings ledger" },
    "/tu_wallets/{walletId}": { "schema": "tu_wallet", "description": "TU physical cash tracking (ID: schoolId_TUuid)" },
    "/transactions/{transactionId}": { "schema": "transaction", "description": "High-integrity immutable transaction logs" },
    "/system/config": { "schema": "system_config", "description": "Global application configuration" }
  }
}
